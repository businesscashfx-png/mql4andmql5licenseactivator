// Recursos de la aplicación BCFX Activador de Licencias (Windows)
1 ICON "app.ico"
1 MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "BCFX Activador de Licencias MQL4/MQL5"
      VALUE "ProductName", "BCFX License Activator"
      VALUE "CompanyName", "BCFX"
      VALUE "FileVersion", "1.1.0.0"
      VALUE "ProductVersion", "1.1.0.0"
      VALUE "OriginalFilename", "BCFX_Activador_Windows.exe"
      VALUE "LegalCopyright", "BCFX"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
